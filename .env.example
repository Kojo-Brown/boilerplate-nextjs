DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextjs_db
NEXTAUTH_SECRET=change-me-at-least-32-chars-long!!
# The origin this application is served from. **Required in production** — the
# app refuses to boot without it, because it is the origin session cookies,
# OAuth callbacks and post-sign-in redirects are issued for, and its scheme
# decides whether the session cookie is marked Secure and carries the `__Host-`
# prefix. Set it to the public https:// URL of the deployment.
#
# It is also what lets `trustHost` be enabled safely: with it set, Auth.js takes
# its origin from here rather than from `x-forwarded-host`/`x-forwarded-proto`,
# which are headers a caller sends. Auth.js's own name for this setting is
# AUTH_URL; either works, and AUTH_URL wins if both are present.
# See docs/session-hardening.md.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra origins allowed to post Server Actions, comma-separated. Leave blank
# unless this app sits behind a proxy that rewrites neither `Host` nor
# `X-Forwarded-Host` — the origin check accepts the request's own host, which is
# what a browser sends. Full origins or bare hosts both work:
#   ALLOWED_ACTION_ORIGINS=https://app.example.com,admin.example.com:8443
# See docs/server-actions.md.
ALLOWED_ACTION_ORIGINS=

# How many proxies append to `X-Forwarded-For` between the client and this app
# (optional — defaults to 1). The rate limiter counts back from the *right* of
# that header to find the client, because everything to the left of the entry
# our own infrastructure wrote can be sent by the client. Get this number too
# high and the limiter keys on an address the caller controls; too low and it
# keys on the proxy, putting every client in one bucket.
#   0 proxies (direct to Node)     — no XFF at all; leave unset
#   1 proxy   (one CDN, LB, nginx) — the default
#   2 proxies (CDN in front of LB) — RATE_LIMIT_TRUSTED_PROXIES=2
# See docs/rate-limiting.md.
RATE_LIMIT_TRUSTED_PROXIES=

# Signing key for CMS preview links (optional — draft mode works without it).
# Leave blank and the preview signer derives its key from NEXTAUTH_SECRET via
# HKDF; set it (32+ chars) to rotate preview links independently of sessions.
# See docs/draft-mode.md.
PREVIEW_SECRET=

# Signing key for the on-demand revalidation webhook, POST /api/revalidate
# (optional — the webhook works without it). Leave blank and the signer derives
# its key from NEXTAUTH_SECRET via HKDF with its own domain separator, so no key
# material is shared with sessions or preview links. Set it (32+ chars) to hand
# a CMS a secret that can revalidate and nothing else.
# See docs/on-demand-revalidation.md.
REVALIDATE_SECRET=

# Where Core Web Vitals batches are forwarded (optional). Leave blank and
# POST /api/vitals writes one JSON line per metric to stdout, which every log
# platform this boilerplate targets already collects — that is the supported
# default, not a disabled state. Set it to a collector's ingest URL to forward
# the batch instead, with VITALS_API_KEY sent as `Authorization: Bearer …`.
# See docs/web-vitals.md.
VITALS_COLLECTOR_URL=
VITALS_API_KEY=

# The site domain registered with Plausible (optional). Leave blank and no
# analytics script is mounted at all — nothing is requested from a third party
# and no page view leaves the browser, which is the supported default for a
# checkout, a CI build and a preview deployment. Set it to the bare domain the
# vendor issued (`app.example.com`, not a URL) to load the ~1 kB script with
# `next/script`'s `afterInteractive` strategy.
#
# NEXT_PUBLIC_ means this value is inlined into the client bundle and is public
# by construction. That is correct for a site identifier and would not be for a
# key — Plausible's ingest needs no key, which is part of why it is the one in
# the catalogue. See docs/third-party-scripts.md.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Read the country from `x-geo-country` on the incoming request (optional).
# Leave blank and only the headers a platform overwrites at its own edge are
# believed — `x-vercel-ip-country` and `cf-ipcountry`. Nothing strips
# `x-geo-country`, so on a deployment with no edge in front of it that header is
# a value the browser typed, and reading it lets any caller pick the market an
# experiment targets them for. Set it to 1 only when a CDN you control
# overwrites the header on every request.
# See docs/experiments.md.
EXPERIMENTS_TRUST_FORWARDED_GEO=

# S3-compatible storage (optional — image upload disabled when absent)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Send the Content Security Policy without enforcing it (optional). Set to 1 for
# a staged rollout: the same policy is sent in
# Content-Security-Policy-Report-Only, so a browser reports what it would have
# blocked and blocks nothing. Next reads the nonce out of that header too, so the
# markup is still nonced — the policy is complete and enforced by nobody, which
# is the point of the mode. Leave blank to enforce.
# See docs/csp.md.
CSP_REPORT_ONLY=
