DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextjs_db
NEXTAUTH_SECRET=change-me-at-least-32-chars-long!!
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra origins allowed to post Server Actions, comma-separated. Leave blank
# unless this app sits behind a proxy that rewrites neither `Host` nor
# `X-Forwarded-Host` — the origin check accepts the request's own host, which is
# what a browser sends. Full origins or bare hosts both work:
#   ALLOWED_ACTION_ORIGINS=https://app.example.com,admin.example.com:8443
# See docs/server-actions.md.
ALLOWED_ACTION_ORIGINS=

# Signing key for CMS preview links (optional — draft mode works without it).
# Leave blank and the preview signer derives its key from NEXTAUTH_SECRET via
# HKDF; set it (32+ chars) to rotate preview links independently of sessions.
# See docs/draft-mode.md.
PREVIEW_SECRET=

# Signing key for the on-demand revalidation webhook, POST /api/revalidate
# (optional — the webhook works without it). Leave blank and the signer derives
# its key from NEXTAUTH_SECRET via HKDF with its own domain separator, so no key
# material is shared with sessions or preview links. Set it (32+ chars) to hand
# a CMS a secret that can revalidate and nothing else.
# See docs/on-demand-revalidation.md.
REVALIDATE_SECRET=

# S3-compatible storage (optional — image upload disabled when absent)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
