generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  posts           Post[]
  sessionFamilies SessionFamily[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  /// Optimistic-concurrency token for `title` and `content`.
  ///
  /// The editor loads a row, someone edits it for a few minutes, and the save
  /// posts back a whole document. Without a token that save is a blind
  /// overwrite: a second writer's edit is gone, nothing errors, and the only
  /// record that it ever existed is in the other person's browser. This column
  /// is what turns that into a detectable event — the update carries the version
  /// it read, matches on it in the `WHERE`, and updates no rows if the value has
  /// moved. See `docs/optimistic-concurrency.md`.
  ///
  /// An integer counter rather than `updatedAt`, which is the other obvious
  /// token and a worse one: two writes inside the same clock tick are
  /// indistinguishable, the column's precision differs across databases, and a
  /// comparison has to survive a round trip through JSON and back into a `Date`.
  /// A counter is exact, and monotonic per row by construction.
  ///
  /// It covers the fields the editor writes and deliberately not `published`:
  /// `togglePublishAction` writes that column and nothing else, so the two
  /// mutations cannot lose each other's work, and making a publish bump this
  /// would reject an open editor's save for a change that touched none of its
  /// fields. See the note on `updatePostAction`.
  version   Int      @default(1)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@map("posts")
}

/// One client-generated idempotency key, and the result it is standing in for.
///
/// The unique index is what makes the whole mechanism work: claiming a key is an
/// `INSERT` that either succeeds or violates `[scope, action, key]`, so two
/// concurrent submissions of the same key cannot both decide they are first.
/// A read-then-write ("does a row exist? no — insert one") looks equivalent and
/// is not: the window between the two statements is exactly the double-submit
/// this table exists to survive.
///
/// `scope` is the principal the key belongs to (`user:<id>`), not a foreign key.
/// It is deliberately opaque so the same table can serve a future scope that is
/// not a user row, and there is no cascade to depend on — `expiresAt` is what
/// removes rows, and a sweep can run without knowing what a scope means.
///
/// `expiresAt` means "when this row stops being authoritative", and what that
/// implies depends on `status`. For `IN_PROGRESS` it is a *lease*: an attempt
/// that crashed between claiming a key and recording its result would otherwise
/// hold that key forever, and the caller could never retry. For `COMPLETED` it
/// is the retention window: after it passes the key is free again, which is the
/// point at which a very late retry re-executes rather than replaying.
model IdempotencyKey {
  id          String            @id @default(cuid())
  key         String
  scope       String
  action      String
  fingerprint String
  /// Identifies the attempt that currently holds this row.
  ///
  /// Without it the lease above is unsafe in the one situation it exists for.
  /// An attempt that stalls past its lease is taken over by a second attempt,
  /// and then wakes up: `WHERE key = …` alone would let it write its result
  /// over the live claim, or delete the row out from under it on the way to
  /// reporting its own failure. Both writes carry the token, so a claim that
  /// has moved on simply matches nothing.
  claimToken  String
  status      IdempotencyStatus @default(IN_PROGRESS)
  /// The successful result, JSON-encoded. Null while in progress — a failed
  /// attempt releases its row instead of storing the failure.
  result      Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  expiresAt   DateTime

  @@unique([scope, action, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// One thing that happened, recorded in the same transaction as the rows that
/// made it happen.
///
/// ## Why a row rather than a function call
///
/// Every mutation here owes an effect to code it does not call: a published
/// post has to drop the blog's cache entries, and one day it will also have to
/// notify a subscriber and update a search index. Doing that inline — write the
/// row, then perform the effect — has no failure mode in the happy path and two
/// outside it. The process can die between the commit and the effect, in which
/// case the effect never happens and nothing records that it was owed; or the
/// effect can be performed against a transaction that then rolls back, in which
/// case it announces something that did not occur.
///
/// A row closes both. It is written inside the same transaction as the domain
/// write, so it exists if and only if that write committed, and it is durable,
/// so an effect that has not been performed yet is still owed after a restart.
/// `src/lib/outbox/` is the whole mechanism; `docs/outbox.md` is the argument.
///
/// ## The states, and why "claimed" is not one of them
///
/// `status` has three values and a claim is not among them. An attempt takes a
/// row by writing `claimToken` and `leaseExpiresAt`, exactly as an attempt takes
/// an `IdempotencyKey`, and a row whose lease has expired is available again —
/// so "claimed" is not a state, it is a `PENDING` row with a live lease. Making
/// it a fourth status would mean two representations of the same fact
/// (`CLAIMED` with an expired lease *is* `PENDING`), and every query would have
/// to remember to handle both.
///
///   PENDING    Owed. Claimable once `availableAt` has passed and no live lease
///              holds it.
///   PROCESSED  Done. Kept for a retention window as an audit trail, then swept.
///   FAILED     Given up on after `MAX_RELAY_ATTEMPTS`, or unparseable. A
///              dead letter: it needs a person, and retrying it forever would
///              bury the rows that could still succeed.
///
/// ## `availableAt`
///
/// When the row becomes claimable. It is `now()` for a new event and moves into
/// the future on each failed attempt, which is how the relay's backoff is
/// expressed — a delay held in the row rather than in a worker's memory, so it
/// survives the worker.
model OutboxEvent {
  id      String @id @default(cuid())
  /// The event name, e.g. `post.published`. A string rather than an enum:
  /// `src/lib/outbox/events.ts` owns the taxonomy and parses this column
  /// through a Zod discriminated union on the way out, and a database enum
  /// would mean a migration to add an event type that only the application
  /// understands anyway.
  type    String
  /// The event's data, as JSON.
  ///
  /// Parsed through a schema on every read, never trusted. A payload written by
  /// one deployment is read by the next, and JSON has no `Date` — the same trap
  /// that makes `IdempotencyKey.result` need an output schema, in a place where
  /// it is worse, because a relay reads rows nobody is waiting for.
  payload Json

  status         OutboxStatus @default(PENDING)
  /// How many attempts have been made. Drives the backoff and the dead letter.
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  /// Identifies the attempt currently holding this row; null when none is.
  ///
  /// Every write that ends an attempt carries it in the `WHERE`, so an attempt
  /// whose lease expired while it was still running cannot mark a row it no
  /// longer owns — the same argument as `IdempotencyKey.claimToken`.
  claimToken     String?
  claimedAt      DateTime?
  /// When the current claim stops being authoritative and the row is claimable
  /// again. A worker that is killed mid-dispatch holds nothing beyond this.
  leaseExpiresAt DateTime?
  processedAt    DateTime?
  /// The last dispatch failure, for the person reading a dead letter.
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// The relay's claim query, in the order it filters: status first, then the
  /// availability window.
  @@index([status, availableAt])
  /// The sweep of processed rows past their retention window.
  @@index([processedAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

/// One sign-in, and the chain of session tokens it has been carried by.
///
/// ## Why a row exists at all under a JWT strategy
///
/// A JWT session cookie is a bearer token with no server-side counterpart: it
/// is valid because it decrypts, and nothing else is consulted. That is the
/// property that makes it cheap, and it costs two things that matter. A stolen
/// cookie cannot be revoked — signing out clears the thief's victim's browser
/// and leaves the copy working — and a theft cannot be *noticed*, because a
/// replayed cookie is byte-identical to a legitimate one.
///
/// This table buys both back at the price of one indexed read per request. It
/// holds no session *data* — the claims still travel in the cookie — only the
/// identity of the token that is currently allowed to speak for this sign-in.
///
/// ## Rotation, and why `previousTokenId` has a deadline
///
/// `id` is the `sid` claim and is stable for the life of the sign-in;
/// `currentTokenId` is the `tid` claim and changes every
/// `SESSION_ROTATION_INTERVAL_S`. Presenting a `tid` that is neither the
/// current one nor the one it just replaced means two parties hold cookies for
/// this sign-in, which is the signal this table exists to produce.
///
/// `previousTokenId` is what keeps that signal from firing on ordinary
/// concurrency. A rotation is a `Set-Cookie` on one response, and every request
/// already in flight when it was sent still carries the old token — a browser
/// loading a page with four parallel route segments issues one request and
/// several sub-requests, and a prefetch can be older still. So the replaced
/// token stays acceptable until `previousValidUntil`, a few seconds later.
/// After that it is reuse. The window is deliberately short and deliberately
/// not infinite: an attacker replaying a cookie they captured minutes ago is
/// exactly the case that must not be excused as concurrency.
///
/// ## Why the previous token is not simply deleted
///
/// Because "this token was retired a moment ago" and "this token was never
/// ours" are different findings and only one of them is an incident. Keeping
/// the retired id is what lets the difference be measured instead of guessed.
///
/// ## `revokedAt`, and why rows are kept after revocation
///
/// Revocation is a write to this row, not a delete: an operator looking at a
/// user's complaint needs to see *why* a session ended, and `TOKEN_REUSE` is a
/// materially different answer from `SIGNED_OUT`. `expiresAt` is what removes
/// rows eventually — it is the absolute deadline, so a row past it can decide
/// nothing that the `sat` claim would not already have decided on its own.
model SessionFamily {
  /// The `sid` claim. Generated at sign-in and never reissued.
  id                 String                   @id
  userId             String
  /// The `tid` claim of the only token currently allowed to speak for this
  /// sign-in.
  currentTokenId     String
  /// The `tid` this one replaced, still accepted until `previousValidUntil`.
  previousTokenId    String?
  previousValidUntil DateTime?
  /// How many times the token has been rotated. Operational signal only:
  /// a session with an implausible count is worth looking at.
  rotations          Int                      @default(0)
  startedAt          DateTime                 @default(now())
  /// The absolute deadline, fixed at sign-in and never extended by activity.
  /// Mirrors the `sat` claim, which enforces the same bound without a read —
  /// this copy is the sweep key, not the authority.
  expiresAt          DateTime
  /// When this session last rotated its token, which is the closest thing to
  /// "last seen" that does not cost a write per request. Not an authorisation
  /// input: the idle bound is the JWT's own `exp`, which a browser cannot
  /// extend, and the absolute bound is the `sat` claim.
  lastSeenAt         DateTime                 @default(now())
  revokedAt          DateTime?
  revokedReason      SessionRevocationReason?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "Revoke every session for this user", which is what a password change and
  /// a support request both need.
  @@index([userId])
  /// The sweep of rows past their absolute deadline.
  @@index([expiresAt])
  @@map("session_families")
}

enum SessionRevocationReason {
  /// The user signed out. The only one of these that is not an incident.
  SIGNED_OUT
  /// A token outside the current/previous pair was presented: two parties hold
  /// cookies for this sign-in.
  TOKEN_REUSE
  /// Past `expiresAt` — the bound that activity does not extend.
  ABSOLUTE_TIMEOUT
  /// Ended deliberately from outside the session: a password change, an
  /// administrator, a "sign out everywhere".
  REVOKED_BY_USER
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  USER
  ADMIN
}
